# Owner writes /etc/sayso/studio.env on the VPS (mode 0600), never in the repo.
# Empty key fields are intentional: provision securely before starting episodes.
RPC_URL=https://testnet-rpc.monad.xyz
# The public endpoint allows 50 requests/s and 15 eth_call/s per IP (INTEGRATIONS §1); writes and the
# CRE CLI's own calls are not paced, so 10 paced reads/s (<= 15 in any second) leaves them headroom.
RPC_READS_PER_SECOND=10
CHAIN_ID=10143
SAYSO_MARKETS=
# Create block of this database's first episode (studio-data-12: 69452459); see .env.example.
SAYSO_START_BLOCK=
OPERATOR_PK=
BOT_PK=
DRIP_PK=
REPORTER_PK=
DRIP_IP_SALT=
DRIP_MAX_PER_IP_DAY=2
CRE_API_KEY=
CRE_MODE=simulation
CRE_CLI_PATH=/opt/sayso/bin/cre
# Built once per release (runbook step 5); without it every CRE run recompiles and overruns its timeout.
CRE_RESOLVER_WASM=/var/lib/sayso/resolver.wasm
STUDIO_REVEAL_URL=https://sayso-studio.43-129-38-115.nip.io
# Judging deployment is on-demand only to fit the testnet MON budget (docs/BLOCKERS.md B15).
STUDIO_HOURLY_EPISODES=false
# Replace with the permanent Vercel project origin; no wildcard, trailing slash or path.
STUDIO_WEB_ORIGINS=https://your-project.vercel.app
# The systemd unit pins STUDIO_DATA_DIR, PORT, STUDIO_BEHIND_CADDY and CRE_RESOLVER_DIR.

# Install root:root mode 0600 as /etc/sayso/indexer.env. Never commit populated values.
# Generate independent URL-safe hex passwords; do not use role keys.
ENVIO_PG_USER=sayso
ENVIO_PG_DATABASE=sayso
ENVIO_PG_PASSWORD=
HASURA_GRAPHQL_ADMIN_SECRET=
# Optional HyperSync token; absent/empty selects explicit RPC sync instead.
ENVIO_API_TOKEN=
# Required without a token. Use a dedicated Monad TESTNET (10143) endpoint.
ENVIO_RPC_URL=
# Allowed web origins, comma-separated (e.g. https://sayso.vercel.app).
SAYSO_WEB_ORIGINS=

# Append the rendered site block to the EXISTING shared Caddyfile; never replace it.
# Render SAYSO_STUDIO_HOST before insertion: the running container has no SAYSO env.
{$SAYSO_STUDIO_HOST} {
	encode zstd gzip

	handle /v1/* {
		header Cache-Control "no-store"
		reverse_proxy 172.18.0.1:13001 {
			# Overwrite client-supplied identity at the public trust boundary.
			header_up X-Sayso-Client-IP {http.request.remote.host}
			header_up X-Forwarded-For {http.request.remote.host}
			flush_interval -1
		}
	}

	handle /media/* {
		reverse_proxy 172.18.0.1:13001
	}

	handle {
		respond 404
	}
}

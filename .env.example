# SAYSO environment. Monad testnet 10143 only. Copy to .env and fill locally; never commit values.

# Chain
RPC_URL=https://testnet-rpc.monad.xyz
# Optional: pace studio reads per second (bursts up to half pass at once); unset = unpaced.
# Set below the provider's per-second limit, e.g. 30 for a 50/s QuickNode plan.
RPC_READS_PER_SECOND=
CHAIN_ID=10143

# Studio keys: one sender per role, each its own nonce stream (ARCHITECTURE section 3)
DEPLOYER_PK=
OPERATOR_PK=
BOT_PK=
DRIP_PK=
REPORTER_PK=
# Public role addresses the deploy script wires (derived from the keys above)
OPERATOR_ADDRESS=
REPORTER_ADDRESS=

# Contracts (cast code each before use)
SAYSO_MARKETS=
AUSD=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
KURU_ROUTER=0x7EFbE105Ca7415dE98F96622173458ac1c054630

# Settlement mode: simulation until CRE deploy access, then don
CRE_MODE=simulation
# Required for a DON deployment: approved deployed resolver workflow ID (nonzero bytes32)
CRE_WORKFLOW_ID=

# Studio runtime: absolute path outside the repo holding studio.sqlite and clips/<id>/ transcribe output
STUDIO_DATA_DIR=
PORT=3001
# Enable only behind the same-host Caddy config in deploy/; forces loopback binding.
STUDIO_BEHIND_CADDY=false
# Disable automatic hourly episodes to run on-demand episodes only.
STUDIO_HOURLY_EPISODES=true
# Stable private HMAC salt for direct-peer IP drip limits; at least 32 characters
DRIP_IP_SALT=
# New addresses one client IP may receive per rolling hour. Judging/production keeps 1 (faucet-drain guard);
# raise only for local rehearsals where the studio and the test browser share one IP
DRIP_MAX_PER_IP_HOUR=1
# Studio reveal origin (also used by the resolver)
STUDIO_REVEAL_URL=
# CRE log catch-up start: the create block of this studio database's FIRST episode (the deployment block
# only for a fresh database). The catch-up holds at a trigger whose episode this database never created.
SAYSO_START_BLOCK=
# Optional: defaults to this repository's cre/resolver directory
CRE_RESOLVER_DIR=
# Optional: installed CRE executable, default "cre"
CRE_CLI_PATH=cre
# Optional: release-built resolver WASM passed to `simulate --wasm`; unset compiles TypeScript on every
# run (fine on a laptop, overran the 120 s run timeout on the 2-vCPU VPS)
CRE_RESOLVER_WASM=
# Exact comma-separated browser origins allowed by CORS (API and SSE); unset = local dev origins
STUDIO_WEB_ORIGINS=

# Web (public at build time); VITE_RP_ID is the permanent <project>.vercel.app host
VITE_RP_ID=
VITE_STUDIO_URL=
VITE_INDEXER_URL=
VITE_RPC_URL=

# Shared-VPS Caddy site block (deploy/Caddyfile); rendered before insertion, e.g. sayso-studio.<ip-dashed>.nip.io
SAYSO_STUDIO_HOST=

# Offline sound generation (tools/sfx): ElevenLabs key, read by the generator only, never shipped to the browser
ELEVEN_LABS_API_KEY=

# Offline transcription (tools/transcribe): engine and model paths, not credentials
WHISPER_CLI=
WHISPER_MODEL=
VOSK_MODEL=
# Optional: defaults to tools/transcribe/vosk (vosk==0.3.45, Python 3.12)
VOSK_PYTHON_PROJECT=

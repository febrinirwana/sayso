# SAYSO environment. Monad testnet 10143 only. Copy to .env and fill locally; never commit values.

# Chain
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143

# Studio keys: one sender per role, each its own nonce stream (ARCHITECTURE section 3)
DEPLOYER_PK=
OPERATOR_PK=
BOT_PK=
DRIP_PK=

# Contracts (cast code each before use)
SAYSO_MARKETS=
AUSD=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
KURU_ROUTER=0x7EFbE105Ca7415dE98F96622173458ac1c054630

# Settlement mode: simulation until CRE deploy access, then don
CRE_MODE=simulation

# Web (public at build time)
VITE_RP_ID=
VITE_STUDIO_URL=
VITE_INDEXER_URL=

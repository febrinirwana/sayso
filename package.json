{
  "name": "sayso",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "cre/*",
    "tools/*"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14",
    "node": ">=24.21.0"
  },
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "test": "bun run --filter '*' test",
    "verify": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "@chainlink/cre-sdk@1.23.0": "cre/resolver/patches/@chainlink%2Fcre-sdk@1.23.0.patch"
  }
}
